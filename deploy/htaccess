# ServiceInvest – .htaccess für IONOS (Apache). Als ".htaccess" in das WordPress-Stammverzeichnis legen.
# Ersetzt die Schutzfunktionen des lokalen router.php.

# --- Staging-Schutz (nur bis zum Livegang aktiv lassen; Datei .htpasswd mit "htpasswd -c" anlegen) ---
# AuthType Basic
# AuthName "SIN Staging"
# AuthUserFile /kunden/homepages/XX/dXXXXXXXX/htdocs/.htpasswd
# Require valid-user

# --- HTTPS erzwingen: erst zum Livegang aktivieren (die Service-Domain bietet kein HTTPS) ---
<IfModule mod_rewrite.c>
RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Livegang: Hauptdomain -> www (wie bisher bei serviceinvest.de; Zeilen erst dann aktivieren) ---
# RewriteCond %{HTTP_HOST} ^serviceinvest\.de$ [NC]
# RewriteRule ^ https://www.serviceinvest.de%{REQUEST_URI} [L,R=301]

# Alte URLs leitet wp-content/mu-plugins/sin-redirects.php weiter.
</IfModule>

# --- Sicherheits-Header ---
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
# HSTS ohne includeSubDomains: nicht alle Subdomains sind sicher auf HTTPS.
Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

Options -Indexes
ServerSignature Off

# --- Sensible Dateien und Angriffsflächen sperren ---
<FilesMatch "^(wp-config\.php|wp-config-sample\.php|xmlrpc\.php|readme\.html|liesmich\.html|license\.txt|\.htpasswd|.*\.(sql|gz|log|bak|sh))$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.(?!well-known)

# --- PHP-Ausführung im Uploads-Ordner verbieten ---
<IfModule mod_rewrite.c>
RewriteRule ^wp-content/uploads/.*\.(php[0-9]?|phtml|phar)$ - [F,L]
# --- Interne WP-Dateien nicht direkt aufrufbar ---
RewriteRule ^wp-admin/includes/ - [F,L]
RewriteRule !^wp-includes/ - [S=3]
RewriteRule ^wp-includes/[^/]+\.php$ - [F,L]
RewriteRule ^wp-includes/js/tinymce/langs/.+\.php - [F,L]
RewriteRule ^wp-includes/theme-compat/ - [F,L]
</IfModule>

# --- WordPress ---
# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress
