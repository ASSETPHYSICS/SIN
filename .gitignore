# Allowlist: alles ignorieren, nur Eigenes versionieren (Branch v1-website: Paket serviceinvest-website auf WordPress).
/*
!/.gitignore
!/.gitattributes
!/README.md
!/router.php
!/tools/
!/deploy/
!/content/
!/wp-content/
/wp-content/*
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/sin-v1/
!/wp-content/mu-plugins/
/wp-content/mu-plugins/*
!/wp-content/mu-plugins/sin-hardening.php
!/wp-content/mu-plugins/site-mail.php
!/wp-content/mu-plugins/local-mail-capture.php

# Vom Import erzeugt
/wp-content/themes/sin-v1/fallback-*.html
# Zwischenschritt des Favicons
/content/v1-build/favicon-64.png

# Große Dateien, Dumps
*.zip
*.sql
*.sql.gz

# Zugangsdaten, Caches, Hilfsdateien
wp-config.php
.env
*.log
.DS_Store
